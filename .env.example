# Meta Model API key (https://dev.meta.ai): used for both Muse Voice Transcribe and Muse Spark.
META_MODEL_API_KEY=

# Optional. Default muse-spark-1.2 (the fastest Spark for voice in our tests).
MUSE_SPARK_MODEL=

# The receptionist's voice in `pnpm demo` (https://elevenlabs.io). Optional ELEVENLABS_MODEL, default eleven_v4_turbo.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
